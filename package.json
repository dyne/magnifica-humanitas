{
  "name": "magnifica-humanitas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "source:check": "python3 scripts/ingest-source.py --check && python3 scripts/ingest-official-sources.py --check && python3 tests/official-snapshots.py && python3 tests/official-parser.py",
    "source:ingest": "python3 scripts/ingest-source.py",
    "source:ingest:official": "python3 scripts/ingest-official-sources.py",
    "content:check": "node scripts/validate-editorial.mjs && node scripts/reading-content.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "check": "npm run typecheck && npm run content:check && npm test && npm run build",
    "test:browser": "playwright test",
    "test:browser:all": "node scripts/check-hosting.mjs",
    "test:published": "node scripts/check-published.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dyne/vite-theme": "https://codeload.github.com/dyne/vite-theme/tar.gz/c485943e103fc1e7a50c6f45853d190f16f57583",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "4.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
