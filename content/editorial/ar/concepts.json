          "p186",
          "p197",
          "p198",
          "p199",
          "p200",
          "p205",
          "p212",
          "p215",
          "p218",
          "p224",
          "p228"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "يحفظ المصدر حقّ الدفاع المشروع بمعناه الدقيق كملاذ أخير، ويمنع تفويض القتل والقرارات النهائية للآلة. رقابة بشرية اسميّة لا تكفي.",
        "sourceRefs": [
          "p182",
          "p186",
          "p197",
          "p198",
          "p199",
          "p200",
          "p205",
          "p212",
          "p215",
          "p218",
          "p224",
          "p228"
        ]
