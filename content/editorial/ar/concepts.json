      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p215",
        "start": 141,
        "end": 177,
        "text": "السّلام الحقيقيّ الذي يُولد من العدل"
      }
    },
    {
      "id": "memory",
      "locale": "ar",
      "title": "الذّاكرة",
      "definition": {
        "kind": "paraphrase",
        "text": "الذّاكرة تحمل خبرة الضحايا إلى الحاضر كي تُرى الكرامة والجراح وتُمنع إعادة العنف.",
