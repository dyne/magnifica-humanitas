  "concepts": [
    {
      "id": "dignity",
      "locale": "ar",
      "title": "كرامة الإنسان",
      "definition": {
        "kind": "paraphrase",
        "text": "بحسب المصدر، لكلّ إنسان قيمة أساسية تسبق الإنجاز والمنفعة والاعتراف الاجتماعيّ؛ لا يكتسب حقّ الاحترام بالإنتاج.",
        "sourceRefs": [
          "p050",
          "p051",
          "p052",
          "p053",
          "p058",
          "p154"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "الكرامة الأخلاقيّة والاجتماعيّة وكرامة الحياة قد تتغيّر؛ الكرامة الوجوديّة لا تُفقد. العمل يعبّر عن القيمة ولا ينشئها، ومحاسبة الشرّ لا تنفي إنسانية فاعله.",
        "sourceRefs": [
          "p050",
          "p051",
          "p052",
          "p053",
          "p058",
          "p154"
        ]
      },
      "foundationRefs": [
        "p050",
        "p052",
        "p053"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p052",
        "start": 472,
        "end": 489,
        "text": "الكرامة الوجوديّة"
      }
    },
    {
      "id": "rights",
      "locale": "ar",
      "title": "حقوق الإنسان",
      "definition": {
        "kind": "paraphrase",
        "text": "حقوق الإنسان تعبير تاريخيّ عن كرامته، عامة وغير قابلة للتنازل، وتطلب ضمانات في الحياة والقانون لا إعلانًا فقط.",
        "sourceRefs": [
          "p054",
          "p055",
          "p056",
          "p057",
          "p081"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "يبقى موقف الكنيسة من الحياة منذ التكوين إلى نهايتها الطبيعية والإجهاض والقتل الرحيم منسوبًا إليها؛ فهمه لا يختبر موافقة القارئ عليه.",
        "sourceRefs": [
          "p054",
          "p055",
          "p056",
          "p057",
          "p081"
        ]
      },
      "foundationRefs": [
        "p054"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p055",
        "start": 36,
        "end": 65,
        "text": "متأصّلة في الإنسان وفي كرامته"
      }
    },
    {
      "id": "common-good",
      "locale": "ar",
      "title": "الخير العام",
      "definition": {
        "kind": "paraphrase",
        "text": "الخير العام خير مشترك وظروف وعلاقات تتيح للأفراد والجماعات النموّ، ولا يُبنى أو يُحفظ إلّا معًا.",
        "sourceRefs": [
          "p059",
          "p060",
          "p061",
          "p062",
          "p063",
          "p064"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "ليس مجموع المنافع الخاصة أو متوسطها. اختلاف الأفكار والمصالح لا يمنع حوارًا واتفاقات أساسية تحفظ الأضعف.",
        "sourceRefs": [
          "p059",
          "p060",
          "p061",
          "p062",
          "p063",
          "p064"
        ]
      },
      "foundationRefs": [
        "p059"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p060",
        "start": 36,
        "end": 47,
        "text": "الخير العام"
      }
    },
    {
      "id": "shared-goods",
      "locale": "ar",
      "title": "الغاية الشّاملة للخيرات",
      "definition": {
        "kind": "paraphrase",
        "text": "الغاية الشّاملة للخيرات تعني أنّ ما يسند الحياة والمعرفة ينبغي أن يخدم الجميع والأجيال المقبلة، لا حامليه الحاليين وحدهم.",
        "sourceRefs": [
          "p065",
          "p066",
          "p067",
          "p108",
          "p178"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "الملكية الخاصة معترف بها لكنها ليست مطلقة؛ وظيفتها الاجتماعية تحدّد استخدامها. لا يفرض النصّ رخصة برمجية أو نموذج ملكية وحيدًا.",
        "sourceRefs": [
          "p065",
          "p066",
          "p067",
          "p108",
          "p178"
        ]
      },
      "foundationRefs": [
        "p065",
        "p066"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p065",
        "start": 54,
        "end": 82,
        "text": "الغاية الشّاملة لخيرات الأرض"
      }
    },
    {
      "id": "subsidiarity",
      "locale": "ar",
      "title": "اللامركزيّة والتّكامل في اتّخاذ القرار",
      "definition": {
        "kind": "paraphrase",
        "text": "اللامركزيّة والتّكامل في اتّخاذ القرار تحميان مبادرة الأشخاص والأسر والهيئات الوسيطة، مع دعم المستويات العليا وتنسيقها بدل امتصاص الأدوار.",
        "sourceRefs": [
          "p068",
          "p069",
          "p070",
          "p071",
          "p072",
          "p087"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "لا يبرّر هذا المبدأ لامبالاة الدولة أو ترك الجماعات بلا موارد؛ القرب من الناس يجب أن يمنحهم سلطة فعلية لا اسم مشاركة فقط.",
        "sourceRefs": [
          "p068",
          "p069",
          "p070",
          "p071",
          "p072",
          "p087"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p068",
        "start": 10,
        "end": 48,
        "text": "اللامركزيّة والتّكامل في اتّخاذ القرار"
      }
    },
    {
      "id": "solidarity",
      "locale": "ar",
      "title": "التّضامن",
      "definition": {
        "kind": "paraphrase",
        "text": "التّضامن قبول واعٍ ومستمرّ لمسؤولية بعضنا عن بعض داخل علاقات تربط مصائر الأفراد والشعوب.",
        "sourceRefs": [
          "p073",
          "p074",
          "p075",
          "p076",
          "p088",
          "p187"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "الاتصال الفعليّ ليس تضامنًا كاملًا. هو مبدأ للعلاقات وفضيلة ممارسة؛ إعانة تلغي قدرة الشخص على الفعل والقرار ليست غايته.",
        "sourceRefs": [
          "p073",
          "p074",
          "p075",
          "p076",
          "p088",
          "p187"
        ]
      },
      "foundationRefs": [
        "p073",
        "p088",
        "p234"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p075",
        "start": 45,
        "end": 53,
        "text": "التّضامن"
      }
    },
    {
      "id": "justice",
      "locale": "ar",
      "title": "العدل الاجتماعيّ",
      "definition": {
        "kind": "paraphrase",
        "text": "العدل الاجتماعيّ يختبر السلوك والهياكل من موقع الضعفاء، ويصل منع الإقصاء بترميم الروابط والضرر القديم.",
        "sourceRefs": [
          "p077",
          "p078",
          "p079",
          "p080",
          "p081",
          "p109",
          "p162",
          "p215",
          "p244"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "لا يقتصر على توزيع الثروة بعد إنتاجها أو محاسبة فرد سيّئ؛ قواعد عادية قد تعيد الظلم، ويحتاج الضحايا صوتًا واعترافًا ودعمًا.",
        "sourceRefs": [
          "p077",
          "p078",
          "p079",
          "p080",
          "p081",
          "p109",
          "p162",
          "p215",
          "p244"
        ]
      },
      "foundationRefs": [
        "p077",
        "p079",
        "p244"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p079",
        "start": 6,
        "end": 22,
        "text": "العدل الاجتماعيّ"
      }
    },
    {
      "id": "development",
      "locale": "ar",
      "title": "التّنمية البشريّة المتكاملة",
      "definition": {
        "kind": "paraphrase",
        "text": "التّنمية البشريّة المتكاملة نموّ كلّ إنسان وكلّ الناس، في الحياة المادية والثقافية والعلاقات والمشاركة والروح والأخلاق، مع البيئة والأجيال المقبلة.",
        "sourceRefs": [
          "p082",
          "p083",
          "p084",
          "p085",
          "p129",
          "p159",
          "p180"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "لا يثبت ازدياد الاستهلاك أو الناتج أو القدرة التقنية وحده جودة التنمية؛ لا يكفي نموّ منطقة على حساب تبعية أخرى.",
        "sourceRefs": [
          "p082",
          "p083",
          "p084",
          "p085",
          "p129",
          "p159",
          "p180"
        ]
      },
      "foundationRefs": [
        "p126",
        "p129"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p082",
        "start": 487,
        "end": 514,
        "text": "التّنمية البشريّة المتكاملة"
      }
    },
    {
      "id": "institutional-accountability",
      "locale": "ar",
      "title": "المساءلة",
      "definition": {
        "kind": "paraphrase",
        "text": "المساءلة تعيين من يتحمّل القرار ويبرّره ويراقبه ويجيب على الطعن ويصلح الضرر، في المؤسسة والتقنية معًا.",
        "sourceRefs": [
          "p086",
          "p087",
          "p089",
          "p105",
          "p138",
          "p176",
          "p177",
          "p200"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "الشفافية لا تكفي دون واجب وسلطة للتصحيح، ووجود إنسان اسميّ في نهاية مسار غامض لا يثبت تحكّمًا مسؤولًا.",
        "sourceRefs": [
          "p086",
          "p087",
          "p089",
          "p105",
          "p138",
          "p176",
          "p177",
          "p200"
        ]
      },
      "foundationRefs": [
        "p086",
        "p089",
        "p176"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p105",
        "start": 416,
        "end": 424,
        "text": "المساءلة"
      }
    },
    {
      "id": "technology-power",
      "locale": "ar",
      "title": "السُّلطة التّكنولوجيّة",
      "definition": {
        "kind": "paraphrase",
        "text": "السّلطة التكنولوجيّة قدرة على تشكيل شروط الوصول والظهور والقرار عبر البيانات والحوسبة والبنى، قبل اختيار المستخدم الفرديّ.",
        "sourceRefs": [
          "p004",
          "p005",
          "p009",
          "p092",
          "p093",
          "p094",
          "p095",
          "p104",
          "p136"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "التقنية قد تعالج وتعلّم وتصل، لكن جعل الكفاءة والسيطرة والربح غايات وحيدة نموذج تكنوقراطيّ لا دليل تقدّم إنسانيّ.",
        "sourceRefs": [
          "p004",
          "p005",
          "p009",
          "p092",
          "p093",
          "p094",
          "p095",
          "p104",
          "p136"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p005",
        "start": 823,
        "end": 843,
        "text": "القوّة التّكنولوجيّة"
      }
    },
    {
      "id": "ai-limits",
      "locale": "ar",
      "title": "حدود الذّكاء الاصطناعيّ",
      "definition": {
        "kind": "paraphrase",
        "text": "يقرّ المصدر بقدرات الذكاء الاصطناعيّ النافعة، ويميّزها عن الخبرة البشرية والوعي والمسؤولية الأخلاقية.",
        "sourceRefs": [
          "p097",
          "p098",
          "p099",
          "p100",
          "p116",
          "p128",
          "p198",
          "p233"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "نفي التجربة والضمير والفهم دعاوى الكاتب الأنثروبولوجية، لا إجماع علميّ نعلنه. لا تساوي محاكاة التعاطف علاقة مسؤولة.",
        "sourceRefs": [
          "p097",
          "p098",
          "p099",
          "p100",
          "p116",
          "p128",
          "p198",
          "p233"
        ]
      },
      "foundationRefs": [
        "p128",
        "p233"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p099",
        "start": 384,
        "end": 396,
        "text": "لا يعيش خبرة"
      }
    },
    {
      "id": "ai-governance",
      "locale": "ar",
      "title": "إدارة الذّكاء الاصطناعيّ",
      "definition": {
        "kind": "paraphrase",
        "text": "إدارة الذكاء الاصطناعيّ توجّه تصميمه وملكيته وقيمه واستخدامه ورقابته إلى الكرامة والعدل والخير العام، مع مشاركة وحقّ للطعن.",
        "sourceRefs": [
          "p071",
          "p072",
          "p104",
          "p105",
          "p106",
          "p107",
          "p109",
          "p164",
          "p197",
          "p198",
          "p199",
          "p200"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "مواءمة الآلة لا تجيب وحدها عمّن اختار القيم. العدل شرط في التصميم، وليس تعويضًا متأخرًا بعد تثبيت الغايات.",
        "sourceRefs": [
          "p071",
          "p072",
          "p104",
          "p105",
          "p106",
          "p107",
          "p109",
          "p164",
          "p197",
          "p198",
          "p199",
          "p200"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p109",
        "start": 902,
        "end": 947,
        "text": "شرط مسبق يجب ممارسته في عمليّة التّصميم نفسها"
      }
    },
    {
      "id": "embodiment",
      "locale": "ar",
      "title": "الجسد والمحدوديّة",
      "definition": {
        "kind": "paraphrase",
        "text": "الجسد والمحدوديّة جزءان من حياة علائقية لا تُقاس بعدد القدرات؛ الضعف لا يجعل إنسانًا أقلّ قيمة.",
        "sourceRefs": [
          "p099",
          "p112",
          "p113",
          "p116",
          "p117",
          "p118",
          "p120",
          "p122",
          "p232",
          "p239"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "يجب السعي لإزالة الألم مع قبول المحدودية، دون وعد بإلغاء كلّ وجع أو تبرير ترك المرض بلا علاج. تيارات التعزيز متنوّعة لا برنامجًا واحدًا.",
        "sourceRefs": [
          "p099",
          "p112",
          "p113",
          "p116",
          "p117",
          "p118",
          "p120",
          "p122",
          "p232",
          "p239"
        ]
      },
      "foundationRefs": [
        "p118",
        "p127",
        "p232",
        "p239"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p118",
        "start": 496,
        "end": 516,
        "text": "محدوديّتنا الجوهريّة"
      }
    },
    {
      "id": "care",
      "locale": "ar",
      "title": "العناية بالآخر",
      "definition": {
        "kind": "paraphrase",
        "text": "العناية بالآخر اعتراف بوجه وشخص وعلاقات وقرارات، وقدرة تُتعلّم في الخبرة وتُحمل من البيت إلى المجتمع.",
        "sourceRefs": [
          "p114",
          "p117",
          "p118",
          "p119",
          "p126",
          "p152",
          "p231",
          "p239"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "تدعم الأدوات الرعاية إن صانت الحرية والحكم؛ لا تستبدل العلاقة بمحاكاة. يوجب §118 السعي لإزالة الألم مع قبول المحدودية.",
        "sourceRefs": [
