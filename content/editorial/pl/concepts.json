      "locale": "pl",
      "title": "Podstawy teologiczne",
      "definition": {
        "kind": "paraphrase",
        "text": "Chrześcijańskie przesłanki źródła wyjaśniają jego wizję godności, relacji, solidarności i nadziei.",
