  "concepts": [
    {
      "id": "dignity",
      "locale": "be",
      "title": "Годнасць чалавека",
      "definition": {
        "kind": "paraphrase",
        "text": "Паводле крыніцы, кожная асоба мае ўнутраную каштоўнасць да дасягненняў, карыснасці, прызнання і маральных заслуг.",
        "sourceRefs": [
          "p050",
          "p051",
          "p052",
          "p053",
          "p058",
          "p154"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Маральная, сацыяльная і экзістэнцыяльная годнасць могуць змяняцца; анталагічная не губляецца. Праца яе выражае, але не стварае. Аўтар абгрунтоўвае яе Божай любоўю.",
        "sourceRefs": [
          "p050",
          "p051",
          "p052",
          "p053",
          "p058",
          "p154"
        ]
      },
      "foundationRefs": [
        "p050",
        "p052",
        "p053"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p052",
        "start": 605,
        "end": 626,
        "text": "анталагічнай годнасці"
      }
    },
    {
      "id": "rights",
      "locale": "be",
      "title": "Правы чалавека",
      "definition": {
        "kind": "paraphrase",
        "text": "Правы чалавека выражаюць неад’емную годнасць і патрабуюць рэальнай абароны ўсіх, а не толькі фармальнага абвяшчэння.",
        "sourceRefs": [
          "p054",
          "p055",
          "p056",
          "p057",
          "p081"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Аўтар захоўвае пазіцыю Касцёла пра жыццё ад зачацця да натуральнай смерці, аборт і эўтаназію. Універсальнасць правоў не залежыць ад поспеху або зманіпуляванай большасці.",
        "sourceRefs": [
          "p054",
          "p055",
          "p056",
          "p057",
          "p081"
        ]
      },
      "foundationRefs": [
        "p054"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p055",
        "start": 0,
        "end": 14,
        "text": "Правы чалавека"
      }
    },
    {
      "id": "common-good",
      "locale": "be",
      "title": "Агульнае дабро",
      "definition": {
        "kind": "paraphrase",
        "text": "Агульнае дабро — умовы і адносіны, што дазваляюць асобам і супольнасцям развівацца разам; у крыніцы гэта сацыяльнае выражэнне годнасці.",
        "sourceRefs": [
          "p059",
          "p060",
          "p061",
          "p062",
          "p063",
          "p064"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Гэта не сума прыватных выгод і не дазвол ахвяраваць асобай дзеля выніку. Унёсак кожнага залежыць ад магчымасцяў; інстытуты павінны забяспечваць справядлівы ўдзел.",
        "sourceRefs": [
          "p059",
          "p060",
          "p061",
          "p062",
          "p063",
          "p064"
        ]
      },
      "foundationRefs": [
        "p059"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p060",
        "start": 38,
        "end": 52,
        "text": "агульнае дабро"
      }
    },
    {
      "id": "shared-goods",
      "locale": "be",
      "title": "Усеагульнае прызначэнне дабротаў",
      "definition": {
        "kind": "paraphrase",
        "text": "Даброты, якія падтрымліваюць жыццё, прызначаны для ўсіх. Гэты прынцып распаўсюджваецца таксама на веды, патэнты, платформы, дадзеныя і інфраструктуру.",
        "sourceRefs": [
          "p065",
          "p066",
          "p067",
          "p108",
          "p178"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Крыніца прызнае прыватную ўласнасць і падпарадкоўвае яе сацыяльнай функцыі. Доступ павінен улічваць уладу над выкарыстаннем, навакольнае асяроддзе і будучыя пакаленні.",
        "sourceRefs": [
          "p065",
          "p066",
          "p067",
          "p108",
          "p178"
        ]
      },
      "foundationRefs": [
        "p065",
        "p066"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p065",
        "start": 75,
        "end": 108,
        "text": "усеагульнага прызначэння дабротаў"
      }
    },
    {
      "id": "subsidiarity",
      "locale": "be",
      "title": "Субсідыярнасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Вышэйшыя інстытуты павінны падтрымліваць адказнасць і свабоду людзей, сем’яў і супольнасцяў, не паглынаючы іх уласную дзейнасць.",
        "sourceRefs": [
          "p068",
          "p069",
          "p070",
          "p071",
          "p072",
          "p087"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Гэта не пасіўнасць дзяржавы і не проста перадача задачы ніжэй. Патрэбны рэсурсы, каардынацыя, гарантыі і ўдзел да таго, як выбар ужо вызначаны.",
        "sourceRefs": [
          "p068",
          "p069",
          "p070",
          "p071",
          "p072",
          "p087"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p068",
        "start": 8,
        "end": 22,
        "text": "субсідыярнасці"
      }
    },
    {
      "id": "solidarity",
      "locale": "be",
      "title": "Салідарнасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Салідарнасць ператварае фактычную ўзаемазалежнасць у свядомую адказнасць за іншых людзей, супольнасці і будучыя пакаленні.",
        "sourceRefs": [
          "p073",
          "p074",
          "p075",
          "p076",
          "p088",
          "p187"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Гэта і грамадскі прынцып, і цнота дзеяння. Яна дапаўняе субсідыярнасць: дапамога не павінна душыць ініцыятыву, а самастойнасць — апраўдваць ізаляцыю.",
        "sourceRefs": [
          "p073",
          "p074",
          "p075",
          "p076",
          "p088",
          "p187"
        ]
      },
      "foundationRefs": [
        "p073",
        "p088",
        "p234"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p073",
        "start": 74,
        "end": 86,
        "text": "салідарнасці"
      }
    },
    {
      "id": "justice",
      "locale": "be",
      "title": "Сацыяльная справядлівасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Сацыяльная справядлівасць датычыць учынкаў, правілаў і структур, якія дазваляюць усім, асабліва найслабейшым, жыць годна.",
        "sourceRefs": [
          "p077",
          "p078",
          "p079",
          "p080",
          "p081",
          "p109",
          "p162",
          "p215",
          "p244"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Пераразмеркаванне патрэбна, але недастаткова: патрабуюцца голас пацярпелых, аднаўленне сувязяў, выпраўленне шкоды і справядлівасць ад пачатку распрацоўкі і вытворчасці.",
        "sourceRefs": [
          "p077",
          "p078",
          "p079",
          "p080",
          "p081",
          "p109",
          "p162",
          "p215",
          "p244"
        ]
      },
      "foundationRefs": [
        "p077",
        "p079",
        "p244"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p077",
        "start": 29,
        "end": 54,
        "text": "сацыяльная справядлівасць"
      }
    },
    {
      "id": "development",
      "locale": "be",
      "title": "Інтэгральнае развіццё чалавека",
      "definition": {
        "kind": "paraphrase",
        "text": "Інтэгральнае развіццё ахоплівае кожнага чалавека, усю асобу і ўсе народы, уключаючы іх адносіны, культуру, матэрыяльныя ўмовы і будучыню.",
        "sourceRefs": [
          "p082",
          "p083",
          "p084",
          "p085",
          "p129",
          "p159",
          "p180"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Тэхнічны рост і ВУП не вычэрпваюць развіцця. Шкода слабейшым, экасістэмам або наступным пакаленням не становіцца сапраўдным прагрэсам праз рост агульных паказчыкаў.",
        "sourceRefs": [
          "p082",
          "p083",
          "p084",
          "p085",
          "p129",
          "p159",
          "p180"
        ]
      },
      "foundationRefs": [
        "p126",
        "p129"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p082",
        "start": 521,
        "end": 552,
        "text": "інтэгральным развіццём чалавека"
      }
    },
    {
      "id": "institutional-accountability",
      "locale": "be",
      "title": "Падсправаздачнасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Падсправаздачнасць дазваляе вызначыць, хто павінен абгрунтоўваць рашэнні, адказваць на праверку і аспрэчванне ды выпраўляць шкодныя наступствы.",
        "sourceRefs": [
          "p086",
          "p087",
          "p089",
          "p105",
          "p138",
          "p176",
          "p177",
          "p200"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Машына не прымае на сябе віну. Тое ж патрабаванне датычыць Касцёла: ахвяры, журналісты, гісторыя саўдзелу і прафілактыка павінны заставацца ў разглядзе.",
        "sourceRefs": [
          "p086",
          "p087",
          "p089",
          "p105",
          "p138",
          "p176",
          "p177",
          "p200"
        ]
      },
      "foundationRefs": [
        "p086",
        "p089",
        "p176"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p086",
        "start": 732,
        "end": 750,
        "text": "падсправаздачнасці"
      }
    },
    {
      "id": "technology-power",
      "locale": "be",
      "title": "Тэхналогіі і ўлада",
      "definition": {
        "kind": "paraphrase",
        "text": "Тэхналогіі арганізуюць доступ, бачнасць і магчымасці дзеяння. Канцэнтрацыя платформаў і рэсурсаў дае ўладу вызначаць умовы жыцця іншых.",
        "sourceRefs": [
          "p004",
          "p005",
          "p009",
          "p092",
          "p093",
          "p094",
          "p095",
          "p104",
          "p136"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Крытыка тэхнакратызму не азначае адмовы ад кожнага інструмента. Аўтар адрознівае карысныя сродкі ад логікі, што робіць эфектыўнасць, кантроль і прыбытак мэтай чалавечага жыцця.",
        "sourceRefs": [
          "p004",
          "p005",
          "p009",
          "p092",
          "p093",
          "p094",
          "p095",
          "p104",
          "p136"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p092",
        "start": 75,
        "end": 99,
        "text": "тэхнакратычнай парадыгмы"
      }
    },
    {
      "id": "ai-limits",
      "locale": "be",
      "title": "Магчымасці і межы ШІ",
      "definition": {
        "kind": "paraphrase",
        "text": "Аўтар прызнае эфектыўныя магчымасці ШІ і адрознівае іх ад чалавечага досведу, сумлення, цялеснасці і сталення ў адносінах.",
        "sourceRefs": [
          "p097",
          "p098",
          "p099",
          "p100",
          "p116",
          "p128",
          "p198",
          "p233"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Катэгарычныя сцвярджэнні пра адсутнасць у машын досведу і сумлення — пазіцыя крыніцы, не абвешчаны навуковы кансенсус. Сам аўтар папярэджвае пра абмежаванасць разгляду і хуткае старэнне ведаў.",
        "sourceRefs": [
          "p097",
          "p098",
          "p099",
          "p100",
          "p116",
          "p128",
          "p198",
          "p233"
        ]
      },
      "foundationRefs": [
        "p128",
        "p233"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p099",
        "start": 42,
        "end": 60,
        "text": "штучнага інтэлекту"
      }
    },
    {
      "id": "ai-governance",
      "locale": "be",
      "title": "Кіраванне штучным інтэлектам",
      "definition": {
        "kind": "paraphrase",
        "text": "Кіраванне ШІ ахоплівае мэты распрацоўкі, удзел, праверку, адказнасць і спосабы аспрэчваць рашэнні на ўсіх этапах выкарыстання.",
        "sourceRefs": [
          "p071",
          "p072",
          "p104",
          "p105",
          "p106",
          "p107",
          "p109",
          "p164",
          "p197",
          "p198",
          "p199",
          "p200"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Карэкціроўкі машыны паводле каштоўнасцяў недастаткова, калі іх выбірае меншасць. У вайне забаронена дэлегаваць смяротныя або незваротныя рашэнні; каштоўнасці ў сістэмах не адмяняюць чалавечага кантролю.",
        "sourceRefs": [
          "p071",
          "p072",
          "p104",
          "p105",
          "p106",
          "p107",
          "p109",
          "p164",
          "p197",
          "p198",
          "p199",
          "p200"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p105",
        "start": 88,
        "end": 132,
        "text": "выразна вызначыць адказнасць на кожным этапе"
      }
    },
    {
      "id": "embodiment",
      "locale": "be",
      "title": "Цела і абмежаванасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Цялеснасць і абмежаванасць належаць чалавечаму жыццю разам з адносінамі, памяццю, уразлівасцю і магчымасцю ўзрастаць.",
        "sourceRefs": [
          "p099",
          "p112",
          "p113",
          "p116",
          "p117",
          "p118",
          "p120",
          "p122",
          "p232",
          "p239"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Прыняцце межаў не апраўдвае адмовы ў дапамозе. Аўтар лічыць правільным палягчаць цярпенне, адрознівае разнастайныя плыні ўдасканалення і крытыкуе ранжыраванне жыццяздольнасці людзей.",
        "sourceRefs": [
          "p099",
          "p112",
          "p113",
          "p116",
          "p117",
          "p118",
          "p120",
          "p122",
          "p232",
          "p239"
        ]
      },
      "foundationRefs": [
        "p118",
        "p127",
        "p232",
        "p239"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p118",
        "start": 85,
        "end": 96,
        "text": "абмежаванне"
      }
    },
    {
      "id": "care",
      "locale": "be",
      "title": "Клопат і блізкасць",
      "definition": {
        "kind": "paraphrase",
        "text": "Клопат прызнае ў іншым асобу з патрэбамі, свабодай і годнасцю, а не толькі функцыю для апрацоўкі або праблему для ліквідацыі.",
        "sourceRefs": [
          "p114",
          "p117",
          "p118",
          "p119",
          "p126",
          "p152",
          "p231",
          "p239"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Тэхналогіі могуць дапамагаць і палягчаць цярпенне. Але хуткасць абслугоўвання і імітацыя спачування самі не даюць узаемных адносінаў, фізічнай блізкасці і чалавечага меркавання.",
        "sourceRefs": [
          "p114",
          "p117",
          "p118",
          "p119",
          "p126",
          "p152",
          "p231",
          "p239"
        ]
      },
      "foundationRefs": [
        "p119",
        "p126",
        "p231",
        "p239"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p114",
        "start": 53,
        "end": 61,
        "text": "клопатам"
      }
    },
    {
      "id": "truth",
      "locale": "be",
      "title": "Праўда і камунікацыя",
      "definition": {
        "kind": "paraphrase",
        "text": "Праўда фактаў патрабуе праверкі, крыніц і адказнай аргументацыі разам з даверам і сумеснымі практыкамі пошуку.",
        "sourceRefs": [
          "p132",
          "p134",
          "p135",
          "p136",
          "p137",
          "p138",
          "p214",
          "p237"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Камунікацыя фармуе культуру, а не толькі перадае звесткі. Патрэбны факты і ўмовы свабоднага меркавання; ні аўтаматызацыя, ні манаполія на інфармацыю іх не гарантуюць.",
        "sourceRefs": [
          "p132",
          "p134",
          "p135",
          "p136",
          "p137",
          "p138",
          "p214",
          "p237"
        ]
      },
      "foundationRefs": [
        "p237"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p132",
        "start": 794,
        "end": 807,
        "text": "праўда фактаў"
      }
    },
    {
      "id": "education",
      "locale": "be",
      "title": "Адукацыя",
      "definition": {
        "kind": "paraphrase",
        "text": "Адукацыя развівае разуменне праз час, пытанні, чытанне, дыялог і адносіны, а не толькі хуткі доступ да адказаў.",
        "sourceRefs": [
          "p139",
          "p140",
          "p141",
          "p142",
          "p143",
          "p144",
          "p145",
          "p146",
          "p147",
          "p238"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Трэба ацэньваць, калі не карыстацца ШІ. Патрэбны роўны доступ, падтрымка настаўнікаў і ахова дзяцей; права бацькоў на выбар адукацыі застаецца пазіцыяй крыніцы.",
        "sourceRefs": [
          "p139",
          "p140",
          "p141",
          "p142",
          "p143",
          "p144",
          "p145",
          "p146",
          "p147",
          "p238"
        ]
      },
      "foundationRefs": [
        "p238"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p139",
        "start": 109,
        "end": 117,
        "text": "адукацыі"
      }
    },
    {
      "id": "work",
      "locale": "be",
      "title": "Праца",
      "definition": {
        "kind": "paraphrase",
        "text": "Праца падтрымлівае даход, самавыяўленне, адказнасць, адносіны і ўнёсак у супольнасць, таму яе страта выходзіць за межы матэрыяльнай недастачы.",
        "sourceRefs": [
          "p148",
          "p149",
          "p150",
          "p151",
          "p152",
          "p153",
          "p154",
          "p156",
          "p157"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Унутраная годнасць не залежыць ад занятасці. Надзвычайная дапамога можа быць патрэбнай, небяспечныя задачы варта здымаць, а беспрацоўе не павінна закрываць шлях да грамадскага ўдзелу.",
        "sourceRefs": [
          "p148",
          "p149",
          "p150",
          "p151",
          "p152",
          "p153",
          "p154",
          "p156",
          "p157"
        ]
      },
      "foundationRefs": [
        "p148"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p149",
        "start": 9,
        "end": 14,
        "text": "праца"
      }
    },
    {
      "id": "distribution",
      "locale": "be",
      "title": "Эканоміка і размеркаванне",
      "definition": {
        "kind": "paraphrase",
        "text": "Справядлівая эканоміка забяспечвае рэальны доступ да дабротаў і магчымасцяў і падпарадкоўвае фінансы, вытворчасць і інавацыі чалавечаму развіццю.",
        "sourceRefs": [
          "p158",
          "p159",
          "p160",
          "p161",
          "p162",
          "p163",
          "p164"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Падаткі і пераразмеркаванне патрэбны, але не выпраўдваюць несправядлівасці пры стварэнні багацця. Рынак і ВУП не здымаюць палітычнай адказнасці за ўключэнне слабейшых.",
        "sourceRefs": [
          "p158",
          "p159",
          "p160",
          "p161",
          "p162",
          "p163",
          "p164"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p162",
        "start": 30,
        "end": 47,
        "text": "пераразмеркавання"
      }
    },
    {
      "id": "family",
      "locale": "be",
      "title": "Сям’я і моладзь",
      "definition": {
        "kind": "paraphrase",
        "text": "Крыніца звязвае сямейнае жыццё і будучыню моладзі з устойлівай працай, падтрымкай, часам і магчымасцю доўгатэрміновых рашэнняў.",
        "sourceRefs": [
          "p165",
          "p166",
          "p167",
          "p168",
          "p169"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Вызначэнне сям’і праз трывалы саюз мужчыны і жанчыны — атрыбутаваная пазіцыя аўтара. Яе трэба разумець разам з патрабаваннямі да палітыкі і эканомікі, не патрабуючы ад чытача згоды.",
        "sourceRefs": [
          "p165",
          "p166",
          "p167",
          "p168",
          "p169"
        ]
      },
      "foundationRefs": [],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p165",
        "start": 0,
        "end": 5,
        "text": "Сям’я"
      }
    },
    {
      "id": "freedom",
      "locale": "be",
      "title": "Свабода і самастойны выбар",
      "definition": {
        "kind": "paraphrase",
        "text": "Свабода патрабуе рэальнай магчымасці меркаваць, выбіраць і ўдзельнічаць, а не толькі фармальнай адсутнасці забароны.",
        "sourceRefs": [
          "p128",
          "p136",
          "p146",
          "p154",
          "p170",
          "p171",
          "p172",
          "p178"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Профілі, увага і дадзеныя могуць стаць сродкам кантролю. Не кожнае выкарыстанне дадзеных прымусовае; крытэрыі — празрыстасць, абарона, магчымасць аспрэчвання і ўплыву на мэты.",
        "sourceRefs": [
          "p128",
          "p136",
          "p146",
          "p154",
          "p170",
          "p171",
          "p172",
          "p178"
        ]
      },
      "foundationRefs": [
        "p128"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p171",
        "start": 967,
        "end": 991,
        "text": "свабода ў лічбавую эпоху"
      }
    },
    {
      "id": "exploitation",
      "locale": "be",
      "title": "Схаваная праца і эксплуатацыя",
      "definition": {
        "kind": "paraphrase",
        "text": "Лічбавыя паслугі могуць залежаць ад схаванай працы, прымусу і прысваення дадзеных, што ператварае людзей і супольнасці ў сродак чужой выгады.",
        "sourceRefs": [
          "p101",
          "p173",
          "p174",
          "p175",
          "p176",
          "p177",
          "p178",
          "p179",
          "p240"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Гандаль людзьмі, працоўная эксплуатацыя і кантроль праз дадзеныя маюць адрозненні. Крытыка павінна ўключаць касцёльны саўдзел у рабстве і цяперашнія абавязкі прафілактыкі, абароны і аднаўлення.",
        "sourceRefs": [
          "p101",
          "p173",
          "p174",
          "p175",
          "p176",
          "p177",
          "p178",
          "p179",
          "p240"
        ]
      },
      "foundationRefs": [
        "p176",
        "p177",
        "p240"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p179",
        "start": 322,
        "end": 343,
        "text": "схаванай эксплуатацыі"
      }
    },
    {
      "id": "peace",
      "locale": "be",
      "title": "Спакой і мір",
      "definition": {
        "kind": "paraphrase",
        "text": "Спакой у крыніцы — справядлівае сумеснае жыццё, падтрыманае адносінамі і інстытутамі, а не проста перапынак паміж войнамі.",
        "sourceRefs": [
          "p182",
          "p186",
          "p197",
          "p198",
          "p199",
          "p200",
          "p205",
          "p212",
          "p215",
          "p218",
          "p224",
          "p228"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Аўтар захоўвае законную самаабарону ў самых строгіх межах і сілу як крайнюю меру. Нельга дэлегаваць незваротныя рашэнні або замяняць эфектыўны чалавечы кантроль намінальным дазволам аператара.",
        "sourceRefs": [
          "p182",
          "p186",
          "p197",
          "p198",
          "p199",
          "p200",
          "p205",
          "p212",
          "p215",
          "p218",
          "p224",
          "p228"
        ]
      },
      "foundationRefs": [
        "p227",
        "p228"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p228",
        "start": 117,
        "end": 123,
        "text": "спакой"
      }
    },
    {
      "id": "memory",
      "locale": "be",
      "title": "Памяць і сведчанне",
      "definition": {
        "kind": "paraphrase",
        "text": "Памяць перадае перажытае ахвярамі і дапаўняе гісторыю, якая высвятляе факты; разам яны супрацьстаяць забыццю і нармалізацыі насілля.",
        "sourceRefs": [
          "p121",
          "p122",
          "p123",
          "p124",
          "p176",
          "p191",
          "p216",
          "p217",
          "p244"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Памятаць не азначае апраўдваць помсту. Гістарычны кантэкст не адмяняе віны, а прабачэнне не сцірае патрэбы ў прызнанні, выпраўленні і прадухіленні шкоды.",
        "sourceRefs": [
          "p121",
          "p122",
          "p123",
          "p124",
          "p176",
          "p191",
          "p216",
          "p217",
          "p244"
        ]
      },
      "foundationRefs": [
        "p121",
        "p244"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p122",
        "start": 661,
        "end": 693,
        "text": "не даць мінуламу сысці ў забыццё"
      }
    },
    {
      "id": "dialogue",
      "locale": "be",
      "title": "Дыялог",
      "definition": {
        "kind": "paraphrase",
        "text": "Дыялог патрабуе слухання, павагі да адрозненняў і рэальнага голасу людзей у рашэннях, што закранаюць іх жыццё.",
        "sourceRefs": [
          "p002",
          "p023",
          "p070",
          "p071",
          "p072",
          "p107",
          "p218",
          "p219",
          "p220",
          "p221",
          "p223",
          "p224"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Ён не патрабуе згоды ва ўсім або нейтралітэту перад несправядлівасцю. Перамовы адкрываюць магчымасць годнага выхаду, але не гарантуюць выніку і не адмяняюць абароны ахвяраў.",
        "sourceRefs": [
          "p002",
          "p023",
          "p070",
          "p071",
          "p072",
          "p107",
          "p218",
          "p219",
          "p220",
          "p221",
          "p223",
          "p224"
        ]
      },
      "foundationRefs": [
        "p002",
        "p223"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p219",
        "start": 52,
        "end": 58,
        "text": "дыялог"
      }
    },
    {
      "id": "hope",
      "locale": "be",
      "title": "Надзея і дзеянне",
      "definition": {
        "kind": "paraphrase",
        "text": "Надзея абапіраецца на крохкія дасягненні інстытутаў, сведчанні людзей і штодзённую вернасць, якія адкрываюць магчымасць іншага развіцця.",
        "sourceRefs": [
          "p123",
          "p124",
          "p125",
          "p126",
          "p211",
          "p212",
          "p236",
          "p241",
          "p243",
          "p245"
        ]
      },
      "necessaryDistinction": {
        "kind": "editorial-interpretation",
        "text": "Гэта не абяцанне аўтаматычнага прагрэсу і не адмова бачыць зло. Людзі маюць розную моц, але могуць дзейнічаць у сваіх рэальных сферах адказнасці.",
        "sourceRefs": [
          "p123",
          "p124",
          "p125",
          "p126",
          "p211",
          "p212",
          "p236",
          "p241",
          "p243",
          "p245"
        ]
      },
      "foundationRefs": [
        "p125",
        "p126",
        "p211",
        "p243",
        "p245"
      ],
      "sourceQuotation": {
        "kind": "quotation",
        "paragraphId": "p123",
        "start": 1110,
        "end": 1126,
        "text": "Маральны прагрэс"
      }
    },
    {
